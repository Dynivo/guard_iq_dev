# =============================================================================
# Frontend .gitignore
# =============================================================================

# Dependencies
node_modules/

# Build
dist/
build/
.vite/
*.tsbuildinfo

# Env — never commit real API hosts with secrets (keep .env.example)
.env
.env.*
!.env.example
*.local

# Logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.cache/
coverage/
.nyc_output/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local scratch
tmp/
temp/
*.log
