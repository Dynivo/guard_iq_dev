# =============================================================================
# Frontend environment template
# =============================================================================
# Copy to `.env.local` (Vite loads this automatically in development):
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put database, Redis, AWS, or LLM secrets here.
# =============================================================================

# [REQUIRED for non-default hosts]
# Backend API base URL including the /api/v1 prefix.
# Local default matches: uvicorn on 127.0.0.1:8000
# Production example: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
