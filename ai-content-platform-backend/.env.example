# =============================================================================
# AI Content Platform — Backend environment template
# =============================================================================
# Copy this file to `.env` and fill in values:
#   cp .env.example .env
#
# Legend:
#   [REQUIRED]  — App will not run correctly without this
#   [OPTIONAL]  — Has a safe default; set only when you need the feature
#   [CONDITIONAL] — Required only when a related feature/provider is enabled
#
# NEVER commit a real `.env` with secrets. Rotate any key that was shared in chat.
# =============================================================================


# ─── Application ─────────────────────────────────────────────────────────────

# [REQUIRED] Runtime mode: development | production | staging
APP_ENV=development

# [OPTIONAL] Extra debug behaviour (stack traces, verbose errors). Use false in production.
APP_DEBUG=true

# [OPTIONAL] Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG


# ─── Database (PostgreSQL) ───────────────────────────────────────────────────

# [REQUIRED] Async SQLAlchemy URL (asyncpg driver).
# Local example:
#   postgresql+asyncpg://postgres:postgres@localhost:5432/ai_content_platform
# Remote RDS example:
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/ai_content_platform
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_content_platform

# [OPTIONAL] SSL mode for Postgres.
#   empty          = auto (SSL for non-localhost hosts)
#   require        = force TLS
#   require-insecure = TLS without cert verify (dev only)
#   disable        = no TLS (local only)
# Do NOT put libpq "sslmode=require" inside DATABASE_URL for asyncpg.
DATABASE_SSL=

# [OPTIONAL] Path to CA bundle (recommended for AWS RDS production).
# Download: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DATABASE_SSL_CA=


# ─── Redis ───────────────────────────────────────────────────────────────────

# [CONDITIONAL] Required when JOB_BACKEND=dramatiq or AI_CACHE_BACKEND=redis.
# Recommended always for production workers. Local default is fine for Mac/Linux Redis.
REDIS_URL=redis://localhost:6379/0


# ─── Qdrant (vector store for article embeddings) ────────────────────────────

# [OPTIONAL] App runs without Qdrant; embedding/upsert is best-effort.
# Local: http://localhost:6333  |  Cloud: https://YOUR-CLUSTER.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# [CONDITIONAL] Required for Qdrant Cloud / secured clusters.
QDRANT_API_KEY=


# ─── News connector API keys ─────────────────────────────────────────────────
# Free RSS sources (HN, NCSC, MSRC) need no keys.
# Set keys only for paid/API connectors you enable under Sources.

# [OPTIONAL] NewsData.io — used when a news_api source has no per-source api_key
NEWSDATA_API_KEY=

# [OPTIONAL] GNews connector
GNEWS_API_KEY=

# [OPTIONAL] The Guardian Open Platform
GUARDIAN_API_KEY=

# [OPTIONAL] Currents API
CURRENTS_API_KEY=


# ─── Object storage (images, carousels, media) ───────────────────────────────
# All generated illustrations (original / optimized / thumbnail) are written
# through StorageProvider onto local disk.

# [REQUIRED] local = files under STORAGE_LOCAL_ROOT
STORAGE_PROVIDER=local

# [CONDITIONAL] Used when STORAGE_PROVIDER=local (default path is fine for local/dev)
STORAGE_LOCAL_ROOT=data/media

# [OPTIONAL] How media is delivered to the UI.
# backend_stream = authenticated API streams bytes from StorageProvider (default)
DELIVERY_STRATEGY=backend_stream


# ─── Auth (JWT) ──────────────────────────────────────────────────────────────

# [REQUIRED] Signing secret for access tokens. Change before production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-to-a-random-64-char-hex-string

# [REQUIRED] Signing secret for refresh tokens. Must differ from JWT_SECRET_KEY.
JWT_REFRESH_SECRET_KEY=CHANGE-ME-to-another-random-64-char-hex-string

# [OPTIONAL] Algorithm (leave HS256 unless you know you need otherwise)
JWT_ALGORITHM=HS256

# [OPTIONAL] Access token lifetime in minutes (1440 = 24 hours)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# [OPTIONAL] Refresh token lifetime in minutes (10080 = 7 days)
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080


# ─── CORS (frontend origins allowed to call the API) ─────────────────────────

# [REQUIRED] JSON array of exact frontend origins (no trailing slash).
# Local Vite default port is 3000. Add production URL when deploying frontend.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]


# ─── Image generation ────────────────────────────────────────────────────────

# [OPTIONAL] mock = placeholder images (no GPU/API)
#            openai = OpenAI Images API (needs OPENAI_API_KEY)
#            comfyui = self-hosted ComfyUI (needs GPU + COMFYUI_BASE_URL)
IMAGE_PROVIDER=mock

# [CONDITIONAL] Required when IMAGE_PROVIDER=comfyui
COMFYUI_BASE_URL=http://localhost:8188

# [CONDITIONAL] Model when IMAGE_PROVIDER=openai (default gpt-image-1)
OPENAI_IMAGE_MODEL=gpt-image-1


# ─── LLM providers (text: relevance scoring, drafts, etc.) ───────────────────
# Selectable DEFAULT_LLM_PROVIDER values:
#   openai | gemini | perplexity | grok | azure_openai | anthropic | openrouter | ollama | mock

# [OPTIONAL] Default text model provider. Use "mock" to run without any API keys.
DEFAULT_LLM_PROVIDER=mock

# [OPTIONAL] Provider API keys — set only for providers you use
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
VLLM_API_KEY=

# [OPTIONAL] Base URLs (defaults work for official clouds / local Ollama)
GROK_BASE_URL=https://api.x.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1

# [OPTIONAL] Rotate non-writing calls across every LLM that has a key.
# Prefer CONSENSUS_ENABLED for draft writing (scores models, keeps best).
PROVIDER_MIX_ENABLED=false


# ─── Azure OpenAI (chat + embeddings) ────────────────────────────────────────
# [CONDITIONAL] Required when DEFAULT_LLM_PROVIDER=azure_openai
#               and/or EMBEDDING_PROVIDER=azure_openai

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_DIMENSION=1536


# ─── Azure Speech (voice capture STT + optional Hear-draft TTS) ──────────────
# Not Azure OpenAI. Used by Capture / voice features.

# [OPTIONAL] azure | mock  (preferred knobs)
STT_PROVIDER=mock
TTS_PROVIDER=mock

# [OPTIONAL] Legacy alias for STT_PROVIDER — kept for older .env files
TRANSCRIPTION_PROVIDER=mock

# [CONDITIONAL] Required when STT_PROVIDER=azure or TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=

# [OPTIONAL] Recognition language / locale (e.g. en-IN, hi-IN)
AZURE_SPEECH_RECO_LANGUAGE=en-IN
AZURE_SPEECH_LOCALE=en-IN


# ─── Azure Translator (non-English transcripts → English) ────────────────────

# [OPTIONAL] azure | mock
TRANSLATE_PROVIDER=mock

# [CONDITIONAL] Required when TRANSLATE_PROVIDER=azure
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com


# ─── Embeddings ──────────────────────────────────────────────────────────────

# [OPTIONAL] local | openai | azure_openai
# Changing dimension requires a new Qdrant collection / reindex.
EMBEDDING_PROVIDER=local

# [CONDITIONAL] Used when EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# [OPTIONAL] Custom local embedding HTTP service URL (when EMBEDDING_PROVIDER=local)
LOCAL_EMBEDDING_URL=


# ─── AI cache / inference ────────────────────────────────────────────────────

# [OPTIONAL] memory | redis  (redis needs REDIS_URL)
AI_CACHE_BACKEND=memory

# [OPTIONAL] remote | local | gpu_cluster  (routing hint for inference backends)
INFERENCE_BACKEND=remote


# ─── Consensus engine (multi-LLM draft scoring) ──────────────────────────────

# [OPTIONAL] true = generate with several providers and keep the best draft
# Needs multiple *_API_KEY values configured. Costs more; quality usually better.
CONSENSUS_ENABLED=false

# [OPTIONAL] development | cheap | balanced | premium | enterprise
CONSENSUS_POLICY=balanced


# ─── Job backend (background workers) ────────────────────────────────────────

# [REQUIRED for behaviour choice]
#   inline   = run fetch/score/image jobs inside the API process (simple local/dev)
#   dramatiq = queue jobs in Redis; you MUST run a separate worker process
#              (see README → "Background worker")
JOB_BACKEND=inline
