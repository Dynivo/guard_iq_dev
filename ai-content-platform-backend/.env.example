# Content Intelligence Platform — backend environment
# Copy to .env. Never commit the real .env or send it by email/chat.

# =============================================================================
# FILL THESE IN FIRST
# =============================================================================

# Use production for the client installation so placeholder secrets fail fast.
APP_ENV=production

# Local PostgreSQL database used by the Mac installation.
DATABASE_URL=postgresql+asyncpg://content_app:CHANGE-DATABASE-PASSWORD@127.0.0.1:5432/ai_content_platform

# Generate each independently:
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET_KEY=CHANGE-ME-to-a-different-random-64-char-hex-string

# Needed only for the first database seed. Remove this line from .env after
# installation; the client can then change the password in Settings.
SEED_ADMIN_PASSWORD=

# Text generation, relevance screening, and the two image styles.
GEMINI_API_KEY=
OPENAI_API_KEY=

# The local frontend origins allowed to call the API.
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]


# =============================================================================
# VOICE CAPTURE AND TRANSLATION
# =============================================================================

STT_PROVIDER=azure
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_RECO_LANGUAGE=en-IN

TRANSLATE_PROVIDER=azure
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=


# =============================================================================
# WORKING DEFAULTS — normally leave these unchanged
# =============================================================================

# AI routing and image models.
DEFAULT_LLM_PROVIDER=gemini
IMAGE_PROVIDER=openai
IMAGE_PROVIDER_FALLBACK=openai
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_IMAGE_MODEL_PREMIUM=gemini-3-pro-image
GEMINI_VISUAL_CRITIC_MODEL=gemini-flash-latest
IMAGE_VISUAL_CRITIC_ENABLED=true
IMAGE_QUALITY_THRESHOLD=82
IMAGE_MAX_RETRIES=2

# Generated media stays on this Mac.
STORAGE_LOCAL_ROOT=data/media

# Jobs and sources run only in the backend process and only on command.
JOB_BACKEND=inline
SOURCE_CRON_ENABLED=false
MAX_ARTICLES_PER_SOURCE_RUN=100
IRRELEVANT_ARTICLE_RETENTION_DAYS=1
